<?xml version="1.0" encoding="utf-8" ?>
<data>

<onStartDialog>
    <func name="if">
        <condition>
            <func name="checkTimeRegistered" param1="" />
        </condition>
        <ifTrue>
            <func name="startTimeChecker" param1="" />
        </ifTrue>
        <ifFalse>
            <func name="startDialog" param1="dlog_npc_dayly_fight_offer" />
        </ifFalse>
    </func>
</onStartDialog>

<onTimeCheckerKeepWaiting>
    <func name="startDialog" param1="dlog_npc_dayly_fight_warn_time" />
</onTimeCheckerKeepWaiting>

<onTimeCheckerWaitDone>
    <func name="startDialog" param1="dlog_npc_dayly_fight_offer" />
</onTimeCheckerWaitDone>

</data>
